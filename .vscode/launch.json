{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Rent & Play: Android local (USB)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "preLaunchTask": "Rent & Play: Forward local API over USB",
      "toolArgs": ["--dart-define=API_BASE_URL=http://127.0.0.1:3000/api"]
    },
    {
      "name": "Rent & Play: Android local (emulator)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": ["--dart-define=API_BASE_URL=http://10.0.2.2:3000/api"]
    },
    {
      "name": "Rent & Play: Android hosted (Render)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": ["--dart-define=API_BASE_URL=https://rent-and-play.onrender.com/api"]
    }
  ]
}
